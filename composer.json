{
    "name": "frantzmicccoli/geocoder-php-geoportail-lu",
    "description": "Geocoder provider for the geoportail.lu API https://wiki.geoportail.lu/doku.php?id=en:api:rest",
    "keywords": ["geocoder", "geoportail"],
    "homepage": "http://geocoder-php.org",
    "license": "MIT",
    "authors": [
        {
            "name": "Fräntz Miccoli",
            "email": "youwillfindmeiamsure@example.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=8.4",
        "geocoder-php/common-http": "^4.0",
        "willdurand/geocoder": "^5.0",
        "symfony/http-client": "^6.4"
    },
    "require-dev": {
		"phpunit/phpunit": "^9.0",
        "php-http/message": ">=1.0",
        "php-http/curl-client": "^2.3",
        "nyholm/psr7": "1.8.2",
        "geocoder-php/provider-integration-tests": "^1.6"
    },
    "provide": {
        "geocoder-php/provider-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "FrantzMiccoli\\GeoportailLu\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
